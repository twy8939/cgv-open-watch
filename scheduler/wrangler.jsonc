{
  "name": "cgv-open-watch-scheduler",
  "main": "worker.js",
  "compatibility_date": "2026-08-03",
  "workers_dev": true,
  "observability": {
    "enabled": true
  },
  "triggers": {
    "crons": ["*/5 * * * *"]
  },
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "cgv-open-watch",
      "database_id": "a15b299c-39fc-47e7-8c07-308c2087bfb3",
      "migrations_dir": "migrations"
    }
  ],
  "vars": {
    "GITHUB_OWNER": "twy8939",
    "GITHUB_REPO": "cgv-open-watch",
    "GITHUB_WORKFLOW": "watch.yml",
    "GITHUB_REF": "main"
  }
}
