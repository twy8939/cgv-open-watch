{
  "name": "cgv-open-watch-scheduler",
  "main": "worker.js",
  "compatibility_date": "2026-08-03",
  "workers_dev": false,
  "observability": {
    "enabled": true
  },
  "triggers": {
    "crons": ["*/5 * * * *"]
  },
  "vars": {
    "GITHUB_OWNER": "twy8939",
    "GITHUB_REPO": "cgv-open-watch",
    "GITHUB_WORKFLOW": "watch.yml",
    "GITHUB_REF": "main"
  }
}
